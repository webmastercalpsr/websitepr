{
  "name": "calphirho-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node -e \"const fs=require('fs'); try{fs.copyFileSync('docs/index.html','docs/404.html');}catch(e){} try{fs.writeFileSync('docs/CNAME','calphirho.com');}catch(e){}\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && git add docs && git commit -m \"deploy\" || echo no changes && git push"
  },
  "dependencies": {
    "emailjs-com": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "vite": "^7.1.3"
  }
}
